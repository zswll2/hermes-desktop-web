 apps/desktop/src/components/notifications.tsx   | 12 +++++++++++-
 .../tree/renderer/narrow-overlays.tsx           | 10 +++++++++-
 .../src/components/pane-shell/tree/store.ts     |  7 +++++++
 apps/desktop/src/styles.css                     | 17 ++++++++++++++++-
 5 files changed, 57 insertions(+), 5 deletions(-)

